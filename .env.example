# Volcengine speech console API key (one key covers Seed-ASR 2.0 + machine translation).
# Get it at https://console.volcengine.com/speech -> API Key 管理 (access-control key
# with 语音技术 scope). Activate 豆包流式语音识别模型 2.0 and 机器翻译大模型 first.
VOLC_ASR_API_KEY=

# Optional: hotwords beyond the 100-token direct cap.
# Upload hotwords/boosting_table.txt (regenerated on every run) at
# https://console.volcengine.com/speech -> 自学习平台 -> 热词管理,
# then paste the table id here. Re-upload whenever the hotword lists change.
VOLC_BOOSTING_TABLE_ID=

# Optional: enables the context-aware refined pass (model below).
# Get it at https://console.volcengine.com/ark -> API Key 管理.
# Without it, refined falls back to the same MT engine as the drafts.
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-mini-260215
# Optional: fast refined tier (~2x price). First enable 低延迟 (Low latency)
# for this model at https://console.volcengine.com/ark -> 开通管理.
ARK_SERVICE_TIER=default

# Optional fallback translation backend: Alibaba Model Studio (百炼) API key,
# https://bailian.console.aliyun.com -> API-KEY 管理.
DASHSCOPE_API_KEY=
